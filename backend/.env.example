GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GNANI_STT_KEY=your_gnani_stt_key_here
GNANI_TTS_KEY=your_gnani_tts_key_here
GNANI_TTS_MODEL=timbre-v2.5
# Create this PostgreSQL role/database locally before using PostgreSQL.
DATABASE_URL=postgresql+psycopg://rythumitra:replace_with_local_password@127.0.0.1:5432/rythumitra
# Set to 1 once to copy existing SQLite conversations into an empty PostgreSQL database.
MIGRATE_SQLITE_HISTORY=0
# Restrict to your local Vite app during development.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
